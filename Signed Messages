def generar_clave_admin():
    """Genera la clave de admin usando el seed pattern exacto"""
    username = "admin"
    user_bytes = username.encode()
    
    # Seed pattern del sistema (EXACTO)
    base_seed = user_bytes + b"_lovenote_2026_valentine"
    
    print("[*] Generando p...")
    hash_p = hashlib.sha256(base_seed).hexdigest()
    p = nextprime(int(hash_p, 16))
    print(f"[+] p = {p}")
    
    print("[*] Generando q...")
    hash_q = hashlib.sha256(base_seed + b"pki").hexdigest()
    q = nextprime(int(hash_q, 16))
    print(f"[+] q = {q}")
    
    # Construir clave RSA
    n = p * q
    e = 65537
    phi = (p - 1) * (q - 1)
    d = pow(e, -1, phi)
    
    key = RSA.construct((n, e, d, p, q))
    
    print(f"\n[+] n = {n}")
    print(f"[+] e = {e}")
    print(f"[+] d = {d}")
    
    return key

